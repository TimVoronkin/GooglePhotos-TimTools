{
  "manifest_version": 3,
  "name": "Google Photos Tim Tools",
  "version": "0.6",
  "description": "Combined tools for Google Photos: Up Button, Date Search, Delete Shortcut, KML Export, Drag in Time & Smart Archiving",
  "icons": {
    "128": "assets/active/logo-128.png"
  },
  "permissions": ["storage", "downloads", "clipboardWrite", "tabs"],
  "action": {},
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://photos.google.com/*"],
      "js": [
        "src/core/settings.js",
        "src/core/dom_utils.js",
        "src/core/theme.js",
        "src/content/modules/up_button.js",
        "src/content/modules/date_search.js",
        "src/content/modules/delete_shortcut.js",
        "src/content/modules/kml_export/ui.js",
        "src/content/modules/kml_export/extractor.js",
        "src/content/modules/kml_export/generator.js",
        "src/content/modules/kml_export/main.js",
        "src/content/modules/drag_in_time/templates/modal.js",
        "src/content/modules/drag_in_time/templates/card.js",
        "src/content/modules/drag_in_time/templates/confirm_dialog.js",
        "src/content/modules/drag_in_time.js",
        "src/content/modules/smart_archiving/smart_archiving.js",
        "src/content/main.js"
      ],
      "css": [
        "src/content/styles.css",
        "src/content/modules/drag_in_time/styles.css",
        "src/content/modules/smart_archiving/smart_archiving.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/active/*",
        "src/options/options.html",
        "src/content/modules/drag_in_time/templates/*"
      ],
      "matches": ["*://photos.google.com/*"]
    }
  ]
}
