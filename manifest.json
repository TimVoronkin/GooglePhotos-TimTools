{
  "manifest_version": 3,
  "name": "Google Photos Tim Tools",
  "version": "1.0",
  "key": "",
  "description": "Combined tools for Google Photos: Up Button, Date Search, Delete Shortcut, KML Export, Drag in Time & Smart Archiving",
  "icons": {
    "16": "assets/logo/logo-16.png",
    "32": "assets/logo/logo-32.png",
    "48": "assets/logo/logo-48.png",
    "128": "assets/logo/logo-128.png"
  },
  "permissions": ["storage", "downloads", "clipboardWrite"],
  "action": {
    "default_icon": {
      "16": "assets/logo/logo-16.png",
      "32": "assets/logo/logo-32.png",
      "48": "assets/logo/logo-48.png",
      "128": "assets/logo/logo-128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://photos.google.com/*"],
      "js": [
        "src/core/logger.js",
        "src/core/settings.js",
        "src/core/dom_utils.js",
        "src/core/theme.js",
        "src/core/api.js",
        "src/content/modules/up_button/up_button.js",
        "src/content/modules/date_search/date_search.js",
        "src/content/modules/delete_shortcut/delete_shortcut.js",
        "src/content/modules/kml_export/ui.js",
        "src/content/modules/kml_export/extractor.js",
        "src/content/modules/kml_export/generator.js",
        "src/content/modules/kml_export/main.js",
        "src/content/modules/drag_in_time/templates/modal.js",
        "src/content/modules/drag_in_time/templates/card.js",
        "src/content/modules/drag_in_time/templates/confirm_dialog.js",
        "src/content/modules/drag_in_time/drag_in_time.js",
        "src/content/modules/smart_archiving/smart_archiving.js",
        "src/content/modules/album_quick_remove/album_quick_remove.js",
        "src/content/main.js"
      ],
      "css": [
        "src/content/styles.css",
        "src/content/modules/up_button/up_button.css",
        "src/content/modules/date_search/date_search.css",
        "src/content/modules/drag_in_time/styles.css",
        "src/content/modules/smart_archiving/smart_archiving.css",
        "src/content/modules/album_quick_remove/album_quick_remove.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/*",
        "assets/logo/*",
        "src/content/modules/drag_in_time/templates/*",
        "src/content/modules/smart_archiving/mobile_bookmarklet.js"
      ],
      "matches": ["*://photos.google.com/*"]
    }
  ]
}
