{
    "manifest_version": 3,
    "name": "Google Photos Tim's Button",
    "version": "0.2",
    "description": "Adds a button to Google Photos to show the photo in the timeline",
    "icons": {
        "48": "assets/icon48.png"
    },
    "content_scripts": [
        {
            "matches": [
                "*://photos.google.com/*"
            ],
            "js": [
                "src/content.js",
                "src/date_input.js"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "assets/calendar.png",
                "assets/icon-arrow.svg"
            ],
            "matches": [
                "*://photos.google.com/*"
            ]
        }
    ]
}